<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="190dp"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFood1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#F9F9F9">

            <!-- Yemek Fotoğrafı -->
            <ImageView
                android:id="@+id/ivFoodImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:contentDescription="Yemek resmi"
                android:background="@drawable/image_background_rounded"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:layout_marginBottom="12dp" />

            <!-- Yemek Adı -->
            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yemek Adı"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#263238"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Yemek Fiyatı -->
            <TextView
                android:id="@+id/tvFoodPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₺25"
                android:textColor="#00796B"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />

            <!-- Adet Butonları -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <ImageButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#FFCDD2"
                    android:background="@drawable/bg_button_circle"
                    android:src="@drawable/ic_azalt"
                    android:contentDescription="Azalt"
                    app:tint="#B71C1C" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="1"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

                <ImageButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#C8E6C9"
                    android:background="@drawable/bg_button_circle"
                    android:src="@drawable/ic_arttir"
                    android:contentDescription="Arttır"
                    app:tint="#1B5E20" />
            </LinearLayout>

            <!-- Sepete Ekle Butonu -->
            <ImageButton
                android:id="@+id/btnAddToCart"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FFE082"
                android:background="@drawable/bg_button_rounded"
                android:src="@drawable/ic_add"
                android:contentDescription="Sepete Ekle"
                android:scaleType="centerInside"
                app:tint="#FF6F00" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
